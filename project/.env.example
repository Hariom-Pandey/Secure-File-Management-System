# Security & Session
SECRET_KEY=
JWT_SECRET_KEY=

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=groq/compound
GROQ_REQUIRE_SUCCESS=true

# ========================================================
# Supabase Configuration
# ========================================================
# 1. Obtain Project URL & API Key from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use your 'anon' public key or 'service_role' secret key (recommended for backend server):
SUPABASE_KEY=your_supabase_api_key_here

# Supabase Storage Bucket name (default: secure-files)
SUPABASE_STORAGE_BUCKET=secure-files
# Enable storing encrypted files in Supabase Storage (true/false)
USE_SUPABASE_STORAGE=true
